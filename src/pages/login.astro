---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
---

<Layout title="Minha Conta | Ana Ferreira • Gratidão Shop">
    <div class="bg-[#F6EFE8] min-h-screen py-10 md:py-16 px-4">
        <div class="max-w-xl mx-auto">
            <div class="mb-6">
                <Breadcrumbs
                    items={[
                        { label: "Início", href: "/" },
                        { label: "Minha Conta", href: "/login" },
                    ]}
                />
            </div>

            <!-- Card Principal -->
            <div class="bg-white rounded-3xl shadow-xl border border-[#D4A33D]/25 overflow-hidden">
                <!-- Header com Brand -->
                <div class="bg-gradient-to-r from-[#6E0D25] to-[#4B0919] p-8 text-center text-white">
                    <span class="text-xs uppercase tracking-widest text-[#D4A33D] font-['Cinzel'] block mb-1">
                        Área do Cliente
                    </span>
                    <h1 class="text-3xl font-black font-['Cinzel'] tracking-tight">
                        Ana Ferreira <span class="text-[#D4A33D]">•</span> Gratidão Shop
                    </h1>
                    <p class="text-xs text-white/80 mt-2 font-light">
                        Acesse sua conta para salvar favoritos, agilizar compras e acompanhar seus pedidos.
                    </p>
                </div>

                <!-- Tabs: Login vs Cadastro -->
                <div class="flex border-b border-slate-100 bg-slate-50/70 p-2 gap-2">
                    <button
                        id="tab-login"
                        class="flex-1 py-3 text-center text-sm font-bold uppercase tracking-wider rounded-xl transition-all cursor-pointer bg-white text-[#6E0D25] shadow-xs font-['Cinzel']"
                    >
                        Já Sou Cliente
                    </button>
                    <button
                        id="tab-register"
                        class="flex-1 py-3 text-center text-sm font-bold uppercase tracking-wider rounded-xl transition-all cursor-pointer text-slate-500 hover:text-[#6E0D25] font-['Cinzel']"
                    >
                        Criar Nova Conta
                    </button>
                </div>

                <div class="p-6 md:p-8">
                    <!-- Form 1: LOGIN -->
                    <form id="form-login" class="space-y-5">
                        <div class="form-control">
                            <label class="label text-xs font-bold uppercase tracking-wider text-[#2F2F2F]/80 pb-1">
                                E-mail *
                            </label>
                            <input
                                type="email"
                                id="login-email"
                                class="input input-bordered w-full rounded-xl bg-slate-50/50 border-slate-200 focus:border-[#6E0D25] focus:bg-white"
                                placeholder="seuemail@exemplo.com"
                                required
                            />
                        </div>

                        <div class="form-control">
                            <label class="label text-xs font-bold uppercase tracking-wider text-[#2F2F2F]/80 pb-1">
                                Senha *
                            </label>
                            <input
                                type="password"
                                id="login-password"
                                class="input input-bordered w-full rounded-xl bg-slate-50/50 border-slate-200 focus:border-[#6E0D25] focus:bg-white"
                                placeholder="Sua senha secreta"
                                required
                            />
                        </div>

                        <button
                            type="submit"
                            class="w-full btn bg-[#6E0D25] hover:bg-[#4B0919] text-white rounded-full py-3.5 font-bold uppercase tracking-wider text-xs shadow-md border-none cursor-pointer mt-2"
                        >
                            Acessar Minha Conta
                        </button>

                        <div class="relative flex py-2 items-center">
                            <div class="flex-grow border-t border-slate-200"></div>
                            <span class="flex-shrink mx-4 text-xs font-bold uppercase text-slate-400">ou</span>
                            <div class="flex-grow border-t border-slate-200"></div>
                        </div>

                        <button
                            type="button"
                            id="btn-google-login"
                            class="w-full btn btn-outline border-slate-200 hover:bg-slate-50 hover:border-slate-300 text-[#2F2F2F] rounded-full py-3 font-semibold text-xs flex items-center justify-center gap-2 cursor-pointer"
                        >
                            <svg class="w-4 h-4" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                            </svg>
                            Entrar com Conta Google
                        </button>
                    </form>

                    <!-- Form 2: CADASTRO -->
                    <form id="form-register" class="space-y-4 hidden">
                        <div class="form-control">
                            <label class="label text-xs font-bold uppercase tracking-wider text-[#2F2F2F]/80 pb-1">
                                Nome Completo *
                            </label>
                            <input
                                type="text"
                                id="reg-name"
                                class="input input-bordered w-full rounded-xl bg-slate-50/50 border-slate-200 focus:border-[#6E0D25] focus:bg-white"
                                placeholder="Seu nome completo"
                                required
                            />
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="form-control">
                                <label class="label text-xs font-bold uppercase tracking-wider text-[#2F2F2F]/80 pb-1">
                                    E-mail *
                                </label>
                                <input
                                    type="email"
                                    id="reg-email"
                                    class="input input-bordered w-full rounded-xl bg-slate-50/50 border-slate-200 focus:border-[#6E0D25] focus:bg-white"
                                    placeholder="seuemail@exemplo.com"
                                    required
                                />
                            </div>

                            <div class="form-control">
                                <label class="label text-xs font-bold uppercase tracking-wider text-[#2F2F2F]/80 pb-1">
                                    Celular / Telefone *
                                </label>
                                <input
                                    type="tel"
                                    id="reg-phone"
                                    class="input input-bordered w-full rounded-xl bg-slate-50/50 border-slate-200 focus:border-[#6E0D25] focus:bg-white"
                                    placeholder="(84) 9.9999-9999"
                                    required
                                />
                            </div>
                        </div>

                        <div class="form-control">
                            <label class="label text-xs font-bold uppercase tracking-wider text-[#2F2F2F]/80 pb-1">
                                Criar Senha (Mínimo 6 caracteres) *
                            </label>
                            <input
                                type="password"
                                id="reg-password"
                                class="input input-bordered w-full rounded-xl bg-slate-50/50 border-slate-200 focus:border-[#6E0D25] focus:bg-white"
                                placeholder="••••••••"
                                minlength="6"
                                required
                            />
                        </div>

                        <!-- Endereço para Envio -->
                        <div class="pt-3 border-t border-slate-100">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-bold uppercase tracking-wider text-[#D4A33D] font-['Cinzel']">
                                    Endereço de Entrega (Opcional)
                                </span>
                                <span id="reg-cep-badge" class="hidden text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 uppercase tracking-wider">
                                    OpenCEP
                                </span>
                            </div>

                            <div class="grid grid-cols-3 gap-3 mb-3">
                                <div class="form-control col-span-1">
                                    <input
                                        type="text"
                                        id="reg-zip"
                                        maxlength="9"
                                        class="input input-bordered w-full rounded-xl text-xs bg-slate-50/50 border-slate-200 focus:border-[#6E0D25]"
                                        placeholder="CEP"
                                    />
                                </div>
                                <div class="form-control col-span-2">
                                    <input
                                        type="text"
                                        id="reg-street"
                                        class="input input-bordered w-full rounded-xl text-xs bg-slate-50/50 border-slate-200 focus:border-[#6E0D25]"
                                        placeholder="Rua / Logradouro"
                                    />
                                </div>
                            </div>

                            <div class="grid grid-cols-3 gap-3">
                                <div class="form-control">
                                    <input
                                        type="text"
                                        id="reg-number"
                                        class="input input-bordered w-full rounded-xl text-xs bg-slate-50/50 border-slate-200 focus:border-[#6E0D25]"
                                        placeholder="Número"
                                    />
                                </div>
                                <div class="form-control">
                                    <input
                                        type="text"
                                        id="reg-city"
                                        class="input input-bordered w-full rounded-xl text-xs bg-slate-50/50 border-slate-200 focus:border-[#6E0D25]"
                                        placeholder="Cidade"
                                    />
                                </div>
                                <div class="form-control">
                                    <input
                                        type="text"
                                        id="reg-state"
                                        class="input input-bordered w-full rounded-xl text-xs bg-slate-50/50 border-slate-200 focus:border-[#6E0D25]"
                                        placeholder="UF"
                                    />
                                </div>
                            </div>
                        </div>

                        <button
                            type="submit"
                            class="w-full btn bg-[#6E0D25] hover:bg-[#4B0919] text-white rounded-full py-3.5 font-bold uppercase tracking-wider text-xs shadow-md border-none cursor-pointer mt-4"
                        >
                            Concluir Cadastro & Entrar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { loginUser, registerUser, loginWithGoogle, currentUser } from "../store/authStore";
    import { fetchAddressByCep, formatCep } from "../utils/cep";
    import { toast } from "sonner";

    function initAuthPage() {
        const tabLogin = document.getElementById("tab-login");
        const tabRegister = document.getElementById("tab-register");
        const formLogin = document.getElementById("form-login") as HTMLFormElement;
        const formRegister = document.getElementById("form-register") as HTMLFormElement;
        const btnGoogle = document.getElementById("btn-google-login");

        // If already logged in, redirect to profile or checkout
        if (currentUser.get()) {
            const redirect = new URLSearchParams(window.location.search).get("redirect") || "/profile";
            window.location.href = redirect;
            return;
        }

        // CEP Auto-lookup with OpenCEP + ViaCEP fallback
        const regZipInput = document.getElementById("reg-zip") as HTMLInputElement;
        const regStreetInput = document.getElementById("reg-street") as HTMLInputElement;
        const regNumberInput = document.getElementById("reg-number") as HTMLInputElement;
        const regCityInput = document.getElementById("reg-city") as HTMLInputElement;
        const regStateInput = document.getElementById("reg-state") as HTMLInputElement;
        const regCepBadge = document.getElementById("reg-cep-badge");

        let isLookingUpCep = false;
        async function handleRegCepLookup() {
            if (!regZipInput || isLookingUpCep) return;
            const digits = regZipInput.value.replace(/\D/g, "");

            if (digits.length === 8) {
                regZipInput.value = formatCep(digits);
                isLookingUpCep = true;
                toast.loading("Buscando endereço via CEP...", { id: "reg-cep-loading" });

                const res = await fetchAddressByCep(digits);
                toast.dismiss("reg-cep-loading");

                if (res.success && res.address) {
                    if (regStreetInput) regStreetInput.value = res.address.logradouro;
                    if (regCityInput) regCityInput.value = res.address.localidade;
                    if (regStateInput) regStateInput.value = res.address.uf;

                    if (regCepBadge) {
                        regCepBadge.textContent = res.source === 'opencep' ? 'OpenCEP' : 'ViaCEP';
                        regCepBadge.classList.remove("hidden");
                    }

                    toast.success(`Endereço preenchido (${res.source === 'opencep' ? 'OpenCEP' : 'ViaCEP'})!`);
                    regNumberInput?.focus();
                } else if (res.error) {
                    toast.error(res.error);
                }
                isLookingUpCep = false;
            }
        }

        regZipInput?.addEventListener("input", (e) => {
            const val = (e.target as HTMLInputElement).value;
            if (val.replace(/\D/g, "").length === 8) {
                handleRegCepLookup();
            }
        });

        regZipInput?.addEventListener("blur", handleRegCepLookup);

        // Toggle Tabs
        tabLogin?.addEventListener("click", () => {
            tabLogin.classList.add("bg-white", "text-[#6E0D25]", "shadow-xs");
            tabLogin.classList.remove("text-slate-500");
            tabRegister?.classList.remove("bg-white", "text-[#6E0D25]", "shadow-xs");
            tabRegister?.classList.add("text-slate-500");
            formLogin?.classList.remove("hidden");
            formRegister?.classList.add("hidden");
        });

        tabRegister?.addEventListener("click", () => {
            tabRegister.classList.add("bg-white", "text-[#6E0D25]", "shadow-xs");
            tabRegister.classList.remove("text-slate-500");
            tabLogin?.classList.remove("bg-white", "text-[#6E0D25]", "shadow-xs");
            tabLogin?.classList.add("text-slate-500");
            formRegister?.classList.remove("hidden");
            formLogin?.classList.add("hidden");
        });

        // Submit Login
        formLogin?.addEventListener("submit", (e) => {
            e.preventDefault();
            const email = (document.getElementById("login-email") as HTMLInputElement)?.value;
            const password = (document.getElementById("login-password") as HTMLInputElement)?.value;

            const res = loginUser(email, password);
            if (res.success) {
                toast.success(res.message);
                const redirect = new URLSearchParams(window.location.search).get("redirect") || "/profile";
                setTimeout(() => window.location.href = redirect, 500);
            } else {
                toast.error(res.message);
            }
        });

        // Submit Register
        formRegister?.addEventListener("submit", (e) => {
            e.preventDefault();
            const name = (document.getElementById("reg-name") as HTMLInputElement)?.value;
            const email = (document.getElementById("reg-email") as HTMLInputElement)?.value;
            const phone = (document.getElementById("reg-phone") as HTMLInputElement)?.value;
            const password = (document.getElementById("reg-password") as HTMLInputElement)?.value;

            const zip = (document.getElementById("reg-zip") as HTMLInputElement)?.value;
            const street = (document.getElementById("reg-street") as HTMLInputElement)?.value;
            const number = (document.getElementById("reg-number") as HTMLInputElement)?.value;
            const city = (document.getElementById("reg-city") as HTMLInputElement)?.value;
            const state = (document.getElementById("reg-state") as HTMLInputElement)?.value;

            const address = zip || street ? {
                zip: zip || "",
                street: street || "",
                number: number || "",
                city: city || "",
                state: state || "",
            } : undefined;

            const res = registerUser({ name, email, password, phone, address });
            if (res.success) {
                toast.success(res.message);
                const redirect = new URLSearchParams(window.location.search).get("redirect") || "/profile";
                setTimeout(() => window.location.href = redirect, 500);
            } else {
                toast.error(res.message);
            }
        });

        // Google Login
        btnGoogle?.addEventListener("click", () => {
            const res = loginWithGoogle();
            if (res.success) {
                toast.success(res.message);
                const redirect = new URLSearchParams(window.location.search).get("redirect") || "/profile";
                setTimeout(() => window.location.href = redirect, 500);
            }
        });
    }

    initAuthPage();
    document.addEventListener("astro:page-load", initAuthPage);
</script>
