---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .slice(0, 2)
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    image: p.data.image,
    date: new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }).format(new Date(p.data.pubDate)),
    author: p.data.author,
  }));

const formattedDate = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }).format(new Date(post.data.pubDate));
---

<Layout>
  <article class="max-w-4xl mx-auto px-4 py-10 lg:py-16">
    <div class="mb-8">
      <Breadcrumbs
        items={[
          { label: "Início", href: "/" },
          { label: "Blog Olfativo", href: "/blog" },
          {
            label: post.data.title.length > 25 ? post.data.title.substring(0, 25) + "..." : post.data.title,
            href: Astro.url.pathname,
          },
        ]}
      />
    </div>

    <img
      src={post.data.image}
      alt={post.data.title}
      class="w-full h-72 md:h-96 object-cover rounded-3xl shadow-xl mb-10 border border-base-200"
    />

    <div class="mb-8 text-center md:text-left">
      <h1
        class="text-3xl md:text-5xl font-black text-base-content mb-4 leading-tight font-['Cinzel'] tracking-tight"
      >
        {post.data.title}
      </h1>

      <p
        class="text-base-content/70 text-sm font-medium flex items-center justify-center md:justify-start gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        {formattedDate}
        <span class="mx-1">•</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
        Por {post.data.author}
      </p>
    </div>

    <div
      class="prose prose-lg prose-headings:font-bold prose-headings:text-base-content prose-headings:font-['Cinzel'] prose-p:text-base-content/80 prose-a:text-primary max-w-none leading-relaxed"
    >
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-base-200 flex flex-wrap items-center justify-between gap-4">
      <a href="/blog" class="btn btn-outline btn-primary rounded-full gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Voltar para o Blog
      </a>

      <a
        href="https://wa.me/5584994224545?text=Ol%C3%A1%2C%20li%20o%20artigo%20no%20blog%20e%20gostaria%20de%20tirar%20uma%20d%C3%BAvida%20sobre%20perfumes!"
        target="_blank"
        rel="noopener noreferrer"
        class="btn bg-emerald-600 hover:bg-emerald-700 text-white rounded-full gap-2"
      >
        Tirar Dúvidas com Ana Ferreira no WhatsApp
      </a>
    </div>

    <!-- Artigos Relacionados -->
    {
      relatedPosts.length > 0 && (
        <section class="mt-20">
          <h2 class="text-2xl md:text-3xl font-black text-base-content mb-8 border-l-4 border-primary pl-4 font-['Cinzel']">
            Artigos Relacionados
          </h2>

          <div class="grid gap-8 md:grid-cols-2">
            {relatedPosts.map((p) => (
              <a
                href={`/blog/${p.slug}`}
                class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 group overflow-hidden border border-base-200"
              >
                <figure class="h-48 overflow-hidden">
                  <img
                    src={p.image}
                    alt={p.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </figure>
                <div class="card-body p-6">
                  <h3 class="card-title text-base font-bold group-hover:text-primary transition-colors font-['Cinzel'] leading-snug">
                    {p.title}
                  </h3>
                  <p class="text-base-content/70 text-sm line-clamp-2">
                    {p.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>
