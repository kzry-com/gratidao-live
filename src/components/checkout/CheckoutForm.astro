---
import { Icon } from "astro-icon/components";
---

<div id="checkout-auth-banner" class="mb-6">
    <!-- Banner populated by script depending on auth state -->
</div>

<form id="checkout-form" class="space-y-8">
    <!-- Informações de Contato -->
    <section class="space-y-4 bg-base-100 p-6 md:p-8 rounded-3xl border border-base-200 shadow-sm">
        <div class="flex items-center gap-3">
            <div
                class="w-8 h-8 bg-primary rounded-xl flex items-center justify-center text-primary-content text-xs font-black"
            >
                1
            </div>
            <h3
                class="text-sm font-black uppercase tracking-wider text-base-content font-['Cinzel']"
            >
                Informações de Contato
            </h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-control w-full">
                <label class="label"
                    ><span
                        class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                        >Nome Completo *</span
                    ></label
                >
                <input
                    type="text"
                    name="name"
                    id="checkout-name"
                    placeholder="Seu nome completo"
                    class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                    required
                />
            </div>
            <div class="form-control w-full">
                <label class="label"
                    ><span
                        class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                        >WhatsApp / Telefone *</span
                    ></label
                >
                <input
                    type="tel"
                    name="phone"
                    id="checkout-phone"
                    placeholder="(84) 9.9999-9999"
                    class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                    required
                />
            </div>
            <div class="form-control w-full md:col-span-2">
                <label class="label"
                    ><span
                        class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                        >E-mail para Confirmação *</span
                    ></label
                >
                <input
                    type="email"
                    name="email"
                    id="checkout-email"
                    placeholder="seuemail@exemplo.com"
                    class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                    required
                />
            </div>
        </div>
    </section>

    <!-- Dados de Entrega -->
    <section class="space-y-4 bg-base-100 p-6 md:p-8 rounded-3xl border border-base-200 shadow-sm">
        <div class="flex items-center gap-3">
            <div
                class="w-8 h-8 bg-primary rounded-xl flex items-center justify-center text-primary-content text-xs font-black"
            >
                2
            </div>
            <h3
                class="text-sm font-black uppercase tracking-wider text-base-content font-['Cinzel']"
            >
                Endereço de Entrega
            </h3>
        </div>
        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="form-control w-full">
                    <label class="label"
                        ><span
                            class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                            >CEP * (Busca Automática)</span
                        ></label
                    >
                    <div class="relative">
                        <input
                            type="text"
                            name="zip"
                            id="checkout-zip"
                            maxlength="9"
                            placeholder="59000-000"
                            class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary font-mono text-sm"
                            required
                        />
                        <span id="cep-badge-source" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-bold uppercase text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">
                            OpenCEP
                        </span>
                    </div>
                </div>
                <div class="form-control w-full md:col-span-2">
                    <label class="label"
                        ><span
                            class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                            >Logradouro / Rua *</span
                        ></label
                    >
                    <input
                        type="text"
                        name="address"
                        id="checkout-address"
                        placeholder="Av. Principal, Rua das Flores"
                        class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                        required
                    />
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="form-control w-full">
                    <label class="label"
                        ><span
                            class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                            >Número *</span
                        ></label
                    >
                    <input
                        type="text"
                        name="number"
                        id="checkout-number"
                        placeholder="123"
                        class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                        required
                    />
                </div>
                <div class="form-control w-full">
                    <label class="label"
                        ><span
                            class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                            >Complemento</span
                        ></label
                    >
                    <input
                        type="text"
                        name="complement"
                        id="checkout-complement"
                        placeholder="Apto 101"
                        class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                    />
                </div>
                <div class="form-control w-full">
                    <label class="label"
                        ><span
                            class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                            >Cidade *</span
                        ></label
                    >
                    <input
                        type="text"
                        name="city"
                        id="checkout-city"
                        placeholder="Natal"
                        class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                        required
                    />
                </div>
                <div class="form-control w-full">
                    <label class="label"
                        ><span
                            class="label-text font-bold text-xs uppercase tracking-wider text-base-content/70"
                            >Estado *</span
                        ></label
                    >
                    <input
                        type="text"
                        name="state"
                        id="checkout-state"
                        placeholder="RN"
                        class="input input-bordered w-full rounded-xl bg-base-100 border-base-300 focus:border-primary focus:ring-1 focus:ring-primary"
                        required
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Método de Pagamento -->
    <section class="space-y-4 bg-base-100 p-6 md:p-8 rounded-3xl border border-base-200 shadow-sm">
        <div class="flex items-center gap-3">
            <div
                class="w-8 h-8 bg-primary rounded-xl flex items-center justify-center text-primary-content text-xs font-black"
            >
                3
            </div>
            <h3
                class="text-sm font-black uppercase tracking-wider text-base-content font-['Cinzel']"
            >
                Forma de Pagamento
            </h3>
        </div>
        
        <div class="p-6 bg-gradient-to-br from-primary to-primary/80 rounded-2xl text-white space-y-4 relative overflow-hidden shadow-lg">
            <Icon
                name="lucide:qr-code"
                class="absolute -right-4 -bottom-4 w-32 h-32 text-white/10 -rotate-12"
            />
            <div class="flex justify-between items-start">
                <div class="flex items-center gap-2">
                    <Icon name="lucide:shield-check" class="w-6 h-6 text-secondary" />
                    <span class="text-xs font-bold uppercase tracking-wider text-secondary">
                        InfinitePay • Pix Dinâmico & Cartão
                    </span>
                </div>
                <span class="text-[10px] font-bold uppercase tracking-widest bg-white/20 px-2.5 py-1 rounded-full">
                    Aprovação Instantânea
                </span>
            </div>
            <div class="space-y-1 py-2">
                <p class="text-[10px] font-bold uppercase tracking-widest opacity-80">
                    Titular do Pedido
                </p>
                <p id="card-holder-display" class="text-lg font-bold">
                    Seu Nome
                </p>
            </div>
            <div class="flex justify-between border-t border-white/20 pt-3 text-xs opacity-90">
                <span>Chave PIX gerada na confirmação</span>
                <span>Garantia de Envio Rápido</span>
            </div>
        </div>
    </section>

    <button
        type="submit"
        class="w-full bg-primary hover:bg-primary/90 text-primary-content rounded-full py-4.5 font-bold uppercase tracking-widest text-sm shadow-xl shadow-primary/20 transition-all flex items-center justify-center gap-3 group cursor-pointer"
    >
        Confirmar e Gerar Pagamento
        <Icon
            name="lucide:arrow-right"
            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
        />
    </button>
</form>

<script>
    import { currentUser } from "../../store/authStore";
    import { fetchAddressByCep, formatCep } from "../../utils/cep";
    import { toast } from "sonner";

    function initCheckoutForm() {
        const nameInput = document.getElementById("checkout-name") as HTMLInputElement;
        const phoneInput = document.getElementById("checkout-phone") as HTMLInputElement;
        const emailInput = document.getElementById("checkout-email") as HTMLInputElement;
        const zipInput = document.getElementById("checkout-zip") as HTMLInputElement;
        const addressInput = document.getElementById("checkout-address") as HTMLInputElement;
        const numberInput = document.getElementById("checkout-number") as HTMLInputElement;
        const complementInput = document.getElementById("checkout-complement") as HTMLInputElement;
        const cityInput = document.getElementById("checkout-city") as HTMLInputElement;
        const stateInput = document.getElementById("checkout-state") as HTMLInputElement;
        const cardHolderDisplay = document.getElementById("card-holder-display");
        const bannerContainer = document.getElementById("checkout-auth-banner");
        const cepBadge = document.getElementById("cep-badge-source");

        nameInput?.addEventListener("input", (e) => {
            if (cardHolderDisplay) {
                cardHolderDisplay.textContent =
                    (e.target as HTMLInputElement).value || "Seu Nome";
            }
        });

        // CEP Auto-lookup with OpenCEP + ViaCEP fallback
        let isLookingUpCep = false;
        async function handleCepLookup() {
            if (!zipInput || isLookingUpCep) return;
            const rawVal = zipInput.value;
            const digits = rawVal.replace(/\D/g, "");

            if (digits.length === 8) {
                zipInput.value = formatCep(digits);
                isLookingUpCep = true;
                toast.loading("Buscando endereço via CEP...", { id: "cep-loading" });

                const res = await fetchAddressByCep(digits);
                toast.dismiss("cep-loading");

                if (res.success && res.address) {
                    if (addressInput) addressInput.value = res.address.logradouro;
                    if (cityInput) cityInput.value = res.address.localidade;
                    if (stateInput) stateInput.value = res.address.uf;
                    if (complementInput && !complementInput.value && res.address.complemento) {
                        complementInput.value = res.address.complemento;
                    }

                    if (cepBadge) {
                        cepBadge.textContent = res.source === 'opencep' ? 'OpenCEP' : 'ViaCEP';
                        cepBadge.classList.remove("hidden");
                    }

                    toast.success(`Endereço localizado (${res.source === 'opencep' ? 'OpenCEP' : 'ViaCEP'})! Informe o número.`);
                    numberInput?.focus();
                } else if (res.error) {
                    toast.error(res.error);
                }
                isLookingUpCep = false;
            }
        }

        zipInput?.addEventListener("input", (e) => {
            const val = (e.target as HTMLInputElement).value;
            if (val.replace(/\D/g, "").length === 8) {
                handleCepLookup();
            }
        });

        zipInput?.addEventListener("blur", handleCepLookup);

        // Pre-fill if logged in
        currentUser.subscribe((user) => {
            if (bannerContainer) {
                if (user) {
                    bannerContainer.innerHTML = `
                        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span class="text-xl">👤</span>
                                <div>
                                    <p class="text-xs font-bold text-emerald-900">Conectado como <strong>${user.name}</strong> (${user.email})</p>
                                    <p class="text-[11px] text-emerald-700">Seus dados de contato e endereço foram preenchidos automaticamente.</p>
                                </div>
                            </div>
                            <a href="/profile" class="text-xs font-bold text-emerald-800 hover:underline shrink-0">Meu Perfil</a>
                        </div>
                    `;

                    if (nameInput && !nameInput.value) nameInput.value = user.name;
                    if (phoneInput && user.phone && !phoneInput.value) phoneInput.value = user.phone;
                    if (emailInput && !emailInput.value) emailInput.value = user.email;
                    if (cardHolderDisplay) cardHolderDisplay.textContent = user.name;

                    if (user.address) {
                        if (zipInput && !zipInput.value) zipInput.value = user.address.zip || "";
                        if (addressInput && !addressInput.value) addressInput.value = user.address.street || "";
                        if (numberInput && !numberInput.value) numberInput.value = user.address.number || "";
                        if (complementInput && !complementInput.value) complementInput.value = user.address.complement || "";
                        if (cityInput && !cityInput.value) cityInput.value = user.address.city || "";
                        if (stateInput && !stateInput.value) stateInput.value = user.address.state || "";
                    }
                } else {
                    bannerContainer.innerHTML = `
                        <div class="p-4 rounded-2xl bg-primary/5 border border-primary/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                            <div class="flex items-center gap-2">
                                <span class="text-lg">✨</span>
                                <p class="text-xs text-base-content/80">
                                    Já possui cadastro? <a href="/login?redirect=/checkout" class="font-bold text-primary hover:underline">Faça login</a> para carregar seu endereço e salvar o pedido em sua conta.
                                </p>
                            </div>
                            <a href="/login?redirect=/checkout" class="btn btn-xs btn-outline btn-primary rounded-full px-4 text-[10px] font-bold uppercase tracking-wider">Entrar</a>
                        </div>
                    `;
                }
            }
        });
    }

    initCheckoutForm();
    document.addEventListener("astro:page-load", initCheckoutForm);
</script>
