---
import { Icon } from "astro-icon/components";
---

<div
    id="ticket-modal"
    class="fixed inset-0 z-10000 flex items-center justify-center px-4 pointer-events-none opacity-0 transition-opacity duration-300"
>
    <div
        id="ticket-overlay"
        class="absolute inset-0 bg-slate-950/80 backdrop-blur-md"
    >
    </div>

    <div
        class="relative bg-base-100 w-full max-w-md rounded-3xl overflow-hidden shadow-2xl scale-95 transition-transform duration-300 border border-base-200"
    >
        <!-- Ticket Header -->
        <div class="bg-primary text-primary-content p-8 text-center space-y-2">
            <div
                class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-inner"
            >
                <Icon name="lucide:check-circle-2" class="w-8 h-8 text-secondary" />
            </div>
            <h2 class="text-2xl font-black uppercase tracking-tight font-['Cinzel']">
                Pedido Confirmado!
            </h2>
            <p
                class="text-xs font-bold text-white/80 uppercase tracking-widest font-['Cinzel']"
            >
                Código: <span id="ticket-id" class="text-white">GRT-78291</span>
            </p>
        </div>

        <!-- Ticket Body -->
        <div class="p-8 space-y-6 relative bg-base-100">
            <div id="ticket-products" class="space-y-3 max-h-48 overflow-y-auto pr-1">
                <!-- Products injected here -->
            </div>

            <div
                class="border-t-2 border-base-300 border-dashed pt-4 space-y-2 text-xs font-bold uppercase tracking-wider text-base-content/60"
            >
                <div class="flex justify-between">
                    <span>Data</span>
                    <span id="ticket-date" class="text-base-content">09 Nov 2026</span>
                </div>
                <div class="flex justify-between">
                    <span>Cliente</span>
                    <span id="ticket-customer" class="text-base-content">Cliente Especial</span>
                </div>
            </div>

            <div class="pt-4 border-t border-base-200">
                <div class="flex justify-between items-center">
                    <span
                        class="text-lg font-black text-base-content font-['Cinzel']"
                        >Total Pago</span
                    >
                    <span
                        id="ticket-total"
                        class="text-2xl font-black text-primary font-['Cinzel']"
                        >R$ 0,00</span
                    >
                </div>
            </div>

            <div class="space-y-3 pt-2">
                <a
                    id="whatsapp-confirm-btn"
                    href="https://wa.me/5584994224545?text=Ol%C3%A1%2C%20acabei%20de%20realizar%20um%20pedido%20pelo%20site%20da%20Gratid%C3%A3o%20Shop!"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary w-full rounded-full font-bold uppercase tracking-wider text-xs shadow-md"
                >
                    Acompanhar no WhatsApp
                </a>

                <button
                    id="close-ticket"
                    class="btn btn-ghost w-full rounded-full font-semibold uppercase tracking-wider text-xs cursor-pointer text-base-content/70"
                >
                    Voltar para a Vitrine
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    #ticket-modal.open {
        pointer-events: auto;
        opacity: 1;
    }
    #ticket-modal.open > div:last-child {
        transform: scale(1);
    }
</style>

<script>
    import { clearCart } from "../../store/cartStore";

    const modal = document.getElementById("ticket-modal");
    const closeBtn = document.getElementById("close-ticket");
    const overlay = document.getElementById("ticket-overlay");

    const closeModal = () => {
        modal?.classList.remove("open");
        clearCart();
        window.location.href = "/";
    };

    closeBtn?.addEventListener("click", closeModal);
    overlay?.addEventListener("click", closeModal);
</script>
