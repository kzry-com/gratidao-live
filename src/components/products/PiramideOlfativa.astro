---
interface Props {
  topo: string[];
  corpo: string[];
  fundo: string[];
}

const { topo = [], corpo = [], fundo = [] } = Astro.props;
---

<div class="w-full max-w-md mx-auto my-6 p-5 rounded-2xl bg-[#F6EFE8] border border-[#D4A33D]/30 shadow-sm">
  <h4 class="text-xs uppercase tracking-widest text-[#6E0D25] font-semibold text-center mb-4 font-heading">
    Pirâmide Olfativa
  </h4>

  <div class="flex flex-col gap-3">
    <!-- Topo -->
    <div class="p-3 rounded-xl bg-white/80 border border-[#D4A33D]/20 shadow-xs">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#D4A33D]"></span>
        <span class="text-xs font-semibold text-[#6E0D25] uppercase tracking-wider">Notas de Topo (Saída)</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {topo.map((nota) => (
          <span class="px-2.5 py-0.5 text-xs rounded-full bg-[#F6EFE8] text-[#2F2F2F] border border-[#D4A33D]/20">
            {nota}
          </span>
        ))}
      </div>
    </div>

    <!-- Corpo -->
    <div class="p-3 rounded-xl bg-[#DB9ABA]/15 border border-[#DB9ABA]/40 shadow-xs">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#DB9ABA]"></span>
        <span class="text-xs font-semibold text-[#6E0D25] uppercase tracking-wider">Notas de Corpo (Coração)</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {corpo.map((nota) => (
          <span class="px-2.5 py-0.5 text-xs rounded-full bg-white/90 text-[#2F2F2F] border border-[#DB9ABA]/30">
            {nota}
          </span>
        ))}
      </div>
    </div>

    <!-- Fundo -->
    <div class="p-3 rounded-xl bg-[#6E0D25] text-white shadow-xs">
      <div class="flex items-center gap-2 mb-1.5">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#D4A33D]"></span>
        <span class="text-xs font-semibold text-[#D4A33D] uppercase tracking-wider">Notas de Fundo (Fixação)</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {fundo.map((nota) => (
          <span class="px-2.5 py-0.5 text-xs rounded-full bg-white/15 text-white/95 border border-white/20">
            {nota}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
