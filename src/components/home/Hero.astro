---
import { Icon } from "astro-icon/components";
---

<section class="relative w-full overflow-hidden">
    <!-- Swiper Container -->
    <div class="swiper hero-swiper h-[380px] sm:h-[460px] md:h-[520px]">
        <div class="swiper-wrapper">
            <!-- Slide 1: Êxtase & Alta Perfumaria -->
            <div class="swiper-slide relative">
                <img
                    src="/assets/images/flatter/anuncios_femininos_26/Novo_Extase_3x4.jpg"
                    alt="Novo Êxtase Ana Ferreira"
                    class="absolute inset-0 w-full h-full object-cover"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-r from-[#6E0D25]/90 via-[#6E0D25]/60 to-transparent flex items-center justify-start px-6 md:px-20 text-left"
                >
                    <div class="max-w-2xl animate-fade-in text-white">
                        <span class="inline-block px-3 py-1 bg-[#D4A33D] text-[#2F2F2F] text-xs font-bold uppercase tracking-widest rounded-full mb-3">
                            Coleção Nobre
                        </span>
                        <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-3 tracking-wide leading-tight">
                            Sua essência, sua assinatura.
                        </h2>
                        <p class="text-sm md:text-base text-white/90 mb-6 max-w-lg font-light">
                            Descubra a nobreza e a alta fixação das fragrâncias autorais e contratipos premium Flatter Beauty & Scents.
                        </p>
                        <div class="flex flex-wrap gap-3">
                            <a
                                href="/category/femininos"
                                class="btn bg-[#D4A33D] hover:bg-[#B88928] text-[#2F2F2F] font-semibold border-none px-6 rounded-full shadow-lg transition-transform hover:scale-105"
                            >
                                Perfumes Femininos
                            </a>
                            <a
                                href="/category/masculinos"
                                class="btn bg-white/20 hover:bg-white/30 text-white border border-white/40 px-6 rounded-full shadow-md backdrop-blur-sm"
                            >
                                Perfumes Masculinos
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2: Masculinos de Prestígio -->
            <div class="swiper-slide relative">
                <img
                    src="/assets/images/flatter/anuncios_masculinos_26/anuncio_perfume_m_adg_3x4.jpg"
                    alt="Coleção Masculina"
                    class="absolute inset-0 w-full h-full object-cover"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-r from-[#2F2F2F]/90 via-[#2F2F2F]/60 to-transparent flex items-center justify-start px-6 md:px-20 text-left"
                >
                    <div class="max-w-2xl text-white">
                        <span class="inline-block px-3 py-1 bg-[#D4A33D] text-[#2F2F2F] text-xs font-bold uppercase tracking-widest rounded-full mb-3">
                            Presença & Imponência
                        </span>
                        <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-3 tracking-wide leading-tight">
                            Perfumaria Masculina
                        </h2>
                        <p class="text-sm md:text-base text-white/90 mb-6 max-w-lg font-light">
                            Do frescor aquático aos amadeirados resinosos e orientais de grande rastro para homens de atitude.
                        </p>
                        <a
                            href="/category/masculinos"
                            class="btn bg-[#6E0D25] hover:bg-[#4B0919] text-white border-none px-6 rounded-full shadow-lg transition-transform hover:scale-105"
                        >
                            Ver Coleção Masculina
                        </a>
                    </div>
                </div>
            </div>

            <!-- Slide 3: Linha Corporal & Body Mystic -->
            <div class="swiper-slide relative">
                <img
                    src="/assets/images/flatter/20250711-flatter-01.jpg"
                    alt="Body Splashes e Cuidados"
                    class="absolute inset-0 w-full h-full object-cover"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-r from-[#6E0D25]/85 via-black/40 to-transparent flex items-center justify-start px-6 md:px-20 text-left"
                >
                    <div class="max-w-2xl text-white">
                        <span class="inline-block px-3 py-1 bg-[#DB9ABA] text-[#2F2F2F] text-xs font-bold uppercase tracking-widest rounded-full mb-3">
                            Autocuidado & Frescor
                        </span>
                        <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-3 tracking-wide leading-tight">
                            Body Mystic & Linha Corporal
                        </h2>
                        <p class="text-sm md:text-base text-white/90 mb-6 max-w-lg font-light">
                            Sensação de banho tomado prolongado com extratos vegetais, hidratação profunda e perfumação leve.
                        </p>
                        <a
                            href="/category/cosmeticos"
                            class="btn bg-[#D4A33D] hover:bg-[#B88928] text-[#2F2F2F] border-none px-6 rounded-full shadow-lg transition-transform hover:scale-105"
                        >
                            Explorar Cosméticos
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="swiper-pagination"></div>

        <!-- Navigation Buttons -->
        <button
            class="swiper-button-prev !hidden sm:!flex !w-10 !h-10 !bg-white/30 hover:!bg-white/60 !rounded-full !backdrop-blur-md after:!text-sm after:!font-bold after:!text-white"
            aria-label="Previous slide"></button>
        <button
            class="swiper-button-next !hidden sm:!flex !w-10 !h-10 !bg-white/30 hover:!bg-white/60 !rounded-full !backdrop-blur-md after:!text-sm after:!font-bold after:!text-white"
            aria-label="Next slide"></button>
    </div>
</section>

<script>
    import Swiper from "swiper";
    import { Navigation, Pagination, Autoplay } from "swiper/modules";
    import "swiper/css";
    import "swiper/css/navigation";
    import "swiper/css/pagination";

    new Swiper(".hero-swiper", {
        modules: [Navigation, Pagination, Autoplay],
        loop: true,
        autoplay: {
            delay: 5000,
            disableOnInteraction: false,
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
        },
    });
</script>
