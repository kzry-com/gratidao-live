---
import { Icon } from "astro-icon/components";

const contactDetails = [
    {
        icon: "lucide:instagram",
        title: "Instagram Oficial",
        lines: ["@lojagratidaoshop", "Novidades, lançamentos e consultoria olfativa"],
        href: "https://www.instagram.com/lojagratidaoshop",
    },
    {
        icon: "lucide:mail",
        title: "E-mail de Contato",
        lines: ["gratidao@gratidao.live"],
        href: "mailto:gratidao@gratidao.live",
    },
    {
        icon: "lucide:shopping-bag",
        title: "Loja Oficial Shopee",
        lines: ["shopee.com.br/annaferreira81", "Mais de 5 anos com avaliações 5 estrelas"],
        href: "https://shopee.com.br/annaferreira81",
    },
    {
        icon: "lucide:map-pin",
        title: "Localização & Entregas",
        lines: ["Natal / RN", "Envios via Melhor Envio para todo o Brasil"],
    },
];
---

<div class="space-y-6 mb-10">
    {
        contactDetails.map((item) => (
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shrink-0 shadow-xs">
                    <Icon name={item.icon} class="w-6 h-6" />
                </div>
                <div>
                    <h3 class="font-bold text-lg text-base-content font-['Cinzel']">{item.title}</h3>
                    {item.href ? (
                        <a 
                            href={item.href} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="text-primary hover:underline font-medium text-sm md:text-base block"
                        >
                            {item.lines[0]}
                        </a>
                    ) : (
                        <p class="font-medium text-base-content text-sm md:text-base">
                            {item.lines[0]}
                        </p>
                    )}
                    {item.lines.length > 1 && (
                        <p class="text-base-content/60 text-xs md:text-sm mt-0.5">
                            {item.lines[1]}
                        </p>
                    )}
                </div>
            </div>
        ))
    }
</div>
