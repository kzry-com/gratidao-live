---
---
<!-- Bottom Navigation PWA Shell -->
<nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#D4A33D]/30 shadow-lg">
  <div class="grid grid-cols-5 h-16 max-w-lg mx-auto">
    <a href="/" class="inline-flex flex-col items-center justify-center text-[#2F2F2F] hover:text-[#6E0D25] transition-colors">
      <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span class="text-[10px] font-medium tracking-wide">Início</span>
    </a>

    <a href="/category/todos" class="inline-flex flex-col items-center justify-center text-[#2F2F2F] hover:text-[#6E0D25] transition-colors">
      <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
      <span class="text-[10px] font-medium tracking-wide">Catálogo</span>
    </a>

    <a href="/favorites" class="inline-flex flex-col items-center justify-center text-[#2F2F2F] hover:text-[#6E0D25] transition-colors">
      <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
      </svg>
      <span class="text-[10px] font-medium tracking-wide">Favoritos</span>
    </a>

    <a href="/checkout" class="inline-flex flex-col items-center justify-center text-[#2F2F2F] hover:text-[#6E0D25] transition-colors relative">
      <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="text-[10px] font-medium tracking-wide">Sacola</span>
    </a>

    <a id="bottom-nav-user" href="/login" class="inline-flex flex-col items-center justify-center text-[#2F2F2F] hover:text-[#6E0D25] transition-colors">
      <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      <span id="bottom-nav-user-label" class="text-[10px] font-medium tracking-wide">Entrar</span>
    </a>
  </div>
</nav>

<script>
    import { currentUser } from "../../store/authStore";

    function updateBottomNav() {
        const userLink = document.getElementById("bottom-nav-user") as HTMLAnchorElement;
        const userLabel = document.getElementById("bottom-nav-user-label");

        currentUser.subscribe((user) => {
            if (userLink && userLabel) {
                if (user) {
                    userLink.href = "/profile";
                    userLabel.textContent = "Perfil";
                } else {
                    userLink.href = "/login";
                    userLabel.textContent = "Entrar";
                }
            }
        });
    }

    updateBottomNav();
    document.addEventListener("astro:page-load", updateBottomNav);
</script>
